project_name=analytics-ozon-wb-ym

# ── Supabase ────────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection String (URI mode)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon/public key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Dashboard → Project Settings → API → JWT Settings → JWKS URL
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Frontend Vite vars (must start with VITE_) ───────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon/public key>
VITE_API_URL=http://localhost:8000

# ── Yandex OAuth ────────────────────────────────────────────────────────────────
# Register redirect URI in Yandex OAuth app: http://localhost:8000/api/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/api/auth/yandex/callback

# ── App ─────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
