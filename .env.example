project_name=analytics-ozon-wb-ym

# ── Supabase ────────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection String (URI mode)
# IMPORTANT: Direct ports 5432/6543 may be blocked. App uses REST API (port 443).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Dashboard → Project Settings → API → JWT Settings → JWKS URL
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Frontend Vite vars (must start with VITE_) ───────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_API_URL=http://localhost:8000

# ── Yandex OAuth ────────────────────────────────────────────────────────────────
# Register redirect URI in Yandex OAuth app: http://localhost:8000/api/auth/yandex/callback
YANDEX_CLIENT_ID=<yandex-client-id>
YANDEX_CLIENT_SECRET=<yandex-client-secret>
YANDEX_REDIRECT_URI=http://localhost:8000/api/auth/yandex/callback

# ── Marketplace Testing Credentials (for pytest) ────────────────────────────────
# Tokens can be found in *.gs files or marketplace dashboards
WB_TEST_TOKEN=<wb-api-token>
YM_TEST_TOKEN=<ym-api-token>
YM_TEST_CAMPAIGN_ID=<ym-campaign-id>
OZON_TEST_CLIENT_ID=<ozon-client-id>
OZON_TEST_API_KEY=<ozon-api-key>

# ── App ─────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
