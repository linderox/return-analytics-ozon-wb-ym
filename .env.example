project_name=analytics-ozon-wb-ym

# ── Supabase ────────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → Database → Connection String (URI mode)
# IMPORTANT: Direct ports 5432/6543 may be blocked. App uses REST API (port 443).
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Dashboard → Project Settings → API → JWT Settings → JWKS URL
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Frontend Vite vars (must start with VITE_) ───────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_API_URL=http://localhost:8000

# ── Yandex OAuth ────────────────────────────────────────────────────────────────
# Oauth yandex client_id not marketplace
OAUTH_YANDEX_CLIENT_ID=<oauth-yandex-client-id>
# Oauth yandex client_secret for login. not marketplace
OAUTH_YANDEX_CLIENT_SECRET=<oauth-yandex-client-secret>
# Oauth from Yandex
YANDEX_REDIRECT_URI=http://localhost:8000/api/auth/yandex/callback

# ── Marketplace Testing Credentials (for pytest) ────────────────────────────────
# ozon seller api client id to get returns
OZON_CLIENT_ID=<ozon-client-id>
# Ozon seller api client secret
OZON_CLIENT_SECRET=<ozon-client-secret>

# Wildberries WB token
WB_TOKEN=<wb-api-token>

# yandex market ym client_id to get data
YM_CLIENT_ID=<ym-campaign-id>
# yandex market ym token
YM_TOKEN=<ym-api-token>

# ── App ─────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=linderox@gmail.com
